#########################################
# SERVER CONFIGURATION
#########################################

# Internal server port inside the container (default: 3000).
# Do NOT change this for Docker - the external port is mapped in docker-compose.yml (3800:3000).
PORT=3000

# Base URL for the application - the URL you use to access your site.
# For Unraid set this to your NAS address, e.g. http://192.168.1.50:3800
# (must match the external port in docker-compose.yml, default 3800).
# NOTE: Passkeys/WebAuthn only work over HTTPS or localhost in the browser.
BASE_URL=http://192.168.1.50:3800/

#ALLOWED_IFRAME_ORIGINS= #DEPRECATED and will be used as ALLOWED_ORIGINS if SET

# Comma-separated list of allowed origins for CORS
# (default: '*' if empty, add your base_url if you want to restrict only to base_url)
# When adding multiple origins, base_url will be included by default
# ALLOWED_ORIGINS: http://internalip:port,https://subdomain.example.com
ALLOWED_ORIGINS=

# Node environment (default: production)
# When set to 'development', ALLOWED_ORIGINS will default to '*'
NODE_ENV=production

#########################################
# DOCKER / UNRAID VOLUME PATHS
#########################################

# Host path for app config (passkeys etc.) - classic Unraid appdata folder.
# Used by docker-compose.yml to mount into the container as /app/config.
APP_DATA_PATH=/mnt/user/appdata/dumbload

# Host path for uploaded/downloaded files - folder inside appdata.
# Used by docker-compose.yml to mount into the container as /app/uploads.
FILES_PATH=/mnt/user/appdata/dumbload-files

#########################################
# FILE UPLOAD SETTINGS
#########################################

# Maximum file size in MB (default: 1024)
MAX_FILE_SIZE=1024

# Directory for uploads (Docker/production; optional)
# Docker: set automatically by docker-compose.yml to /app/uploads - do NOT set here.
# Local dev: falls back to LOCAL_UPLOAD_DIR below.
UPLOAD_DIR=

# Directory for uploads (local dev, fallback: './local_uploads')
LOCAL_UPLOAD_DIR=./local_uploads

# Directory for app config/passkeys (Docker/production; optional)
# Docker: set automatically by docker-compose.yml to /app/config - do NOT set here.
# Local dev: defaults to the upload directory.
DUMBLOAD_CONFIG_DIR=

# Comma-separated list of allowed file extensions (optional, e.g. .jpg,.png,.pdf)
# ALLOWED_EXTENSIONS=.jpg,.png,.pdf
ALLOWED_EXTENSIONS=

#########################################
# SECURITY
#########################################

# PIN protection (4-10 digits, optional)
# DUMBLOAD_PIN=1234
DUMBLOAD_PIN=

# Login session timeout in seconds (default: 28800 = 8 hours).
# - Positive number: session expires that many seconds after login
# - "instant" or 0: session cookie only (login is lost when the browser closes)
# Examples: SESSION_TIMEOUT=900 (15 min), SESSION_TIMEOUT=instant
SESSION_TIMEOUT=28800

# Authentication mode: 'pin', 'passkey', or 'both' (default: 'both')
# - pin:     Only PIN login
# - passkey: Only Passkey/WebAuthn login
# - both:    PIN OR Passkey (recommended: use the PIN as a fallback when you
#            don't have your passkey with you)
DUMBLOAD_AUTH_MODE=both

# Trust proxy headers (X-Forwarded-For, X-Forwarded-Proto).
# REQUIRED when running behind a reverse proxy (e.g. Nginx Proxy Manager,
# Traefik, Cloudflare) so the app detects the real client IP and HTTPS origin.
TRUST_PROXY=true

# Optional: comma-separated list of trusted proxy IPs (restricts which proxy
# may set X-Forwarded-* headers). Requires TRUST_PROXY=true.
# Example: 172.17.0.1,10.0.0.1
TRUSTED_PROXY_IPS=

# WebAuthn Relying Party ID (default: hostname from BASE_URL)
# Set this if your domain/hostname differs from what browsers see
# DUMBLOAD_RP_ID=localhost

# WebAuthn Relying Party name (default: DumbLoad)
# DUMBLOAD_RP_NAME=DumbLoad

# Secret admin path for passkey management.
# - SET (e.g. /admin/passkeys): admin page is enabled, passkeys can be added/removed
# - EMPTY: admin is DISABLED - no passkey changes possible (login still works)
# Change it to something hard to guess, e.g. /admin-8f3k2
DUMBLOAD_ADMIN_PATH=

# NOTE: Passkeys/WebAuthn only work in browsers over HTTPS with a hostname
# (e.g. via a reverse proxy) or on localhost. Plain http://IP:port is blocked
# by the browser. PIN login works everywhere.

#########################################
# GUEST PIN ACCESS
#########################################

# Guest PIN feature: lets the admin create time-limited, usage-limited upload
# PINs from the admin page. Guests enter a name + their PIN on the login page
# and can only upload (no file list, no downloads, no admin).
# Requires DUMBLOAD_PIN to be set (guest PINs share its length).
GUEST_PIN_ENABLED=false

# Default TTL for new guest PINs in minutes (default: 1440 = 24h)
GUEST_PIN_TTL_DEFAULT=1440

# Default max uploads per guest PIN (default: 1; 0 = unlimited)
GUEST_PIN_MAX_UPLOADS_DEFAULT=1

# Default total size quota per guest PIN in MB (default: 500; 0 = unlimited)
GUEST_PIN_MAX_TOTAL_MB_DEFAULT=500

# Folder name prefix for guest uploads (default: 'guest')
# Guest files land in <uploadDir>/<prefix>/<name>_<pinId>_<YYYYMMDD>/
GUEST_PIN_PREFIX=guest

# Session timeout for guest sessions in seconds (default: 14400 = 4h)
GUEST_SESSION_TIMEOUT=14400

#########################################
# MALWARE SCANNING
#########################################

# ClamAV scan scope: 'off' (disabled), 'guest' (only guest uploads),
# or 'all' (every upload, including your own).
CLAMAV_SCAN_ENABLED=off

# clamd address (TCP)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Scan timeout in ms (default: 30000)
CLAMAV_TIMEOUT_MS=30000

# true = accept the upload when clamd is unreachable (with a warning),
# false = reject the upload when clamd is unreachable.
CLAMAV_FAIL_OPEN=true

# Optional VirusTotal scan as an ADDITIONAL engine (applies to ALL uploads,
# runs in the background, never blocks uploads).
# Primary strategy: only the file's SHA-256 hash is sent to VirusTotal for a
# lookup (privacy-safe, no file content is transmitted, works for any size).
# VIRUSTOTAL_UPLOAD_UNKNOWN=true additionally uploads files whose hash is not
# yet known for a fresh analysis - WARNING: in the free tier those samples
# become PUBLIC on VirusTotal. Leave false for hash-lookup-only operation.
VIRUSTOTAL_ENABLED=false
# Comma-separated list of VirusTotal API keys, e.g. "key1,key2,key3".
# When a key hits its free-tier rate limit (or is invalid) the next key is
# used automatically. Example: VIRUSTOTAL_API_KEY=aaa,bbb,ccc
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_UPLOAD_UNKNOWN=false

# Max file size for VirusTotal scans in MB (free tier limit: 32)
VIRUSTOTAL_MAX_FILE_SIZE=32

# Number of malicious engine findings required to treat a file as infected
VIRUSTOTAL_MIN_MALICIOUS_ENGINES=3

#########################################
# NOTIFICATION SETTINGS
#########################################

# Apprise URL for notifications (optional)
APPRISE_URL=

# Notification message template (default: New file uploaded {filename} ({size}), Storage used {storage})
APPRISE_MESSAGE=New file uploaded {filename} ({size}), Storage used {storage}

# Size unit for notifications (B, KB, MB, GB, TB, or Auto; default: Auto)
APPRISE_SIZE_UNIT=Auto

#########################################
# ADVANCED
#########################################

# Enable automatic upload on file selection (true/false, default: false)
AUTO_UPLOAD=false
